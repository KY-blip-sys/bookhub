# ローカルで動作確認するとき用の見本ファイル（実際の値は書かない）。
# コピーして .env.local という名前にし、値を埋めてから `vercel dev` で起動する。
# .env.local自体は.gitignoreでGitの管理対象から外してあるため、GitHubには上がらない。

SUPABASE_URL=
SUPABASE_ANON_KEY=

# OpenAI API（/api/chat が使用）
OPENAI_API_KEY=

# Google Books API（/api/books が使用）
GOOGLE_BOOKS_API_KEY=

# Stripe（/api/stripe/create-checkout-session, /api/stripe/webhook が使用）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
# ブラウザ側で使う公開可能キー（現時点ではCheckoutをサーバー側で作るため未使用。将来Stripe.jsを
# 直接使う場合のために用意）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Webhookがsubscriptionsテーブルを更新するために使うservice role key（RLSを迂回できる鍵）。
# Supabase管理画面 → Project Settings → API → service_role で取得する。絶対に公開しない。
SUPABASE_SERVICE_ROLE_KEY=
